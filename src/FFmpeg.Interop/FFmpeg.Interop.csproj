<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>FFmpeg.Interop</RootNamespace>
    <!-- The shipped library runs the recommended rule set as errors; tests stay on the default set. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- IsAotCompatible only runs the analyzers on this project; this also checks that everything
         it references is annotated compatible. -->
    <VerifyReferenceAotCompatibility>true</VerifyReferenceAotCompatibility>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <IsPackable>true</IsPackable>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>FFmpeg.Interop</PackageId>
    <Description>.NET bindings for FFmpeg 9: a managed API for encoding, decoding, hardware acceleration (D3D11, D3D12, CUDA, AMF, VA-API, Vulkan, VideoToolbox), scaling and resampling, over complete source-generated bindings to the native libraries. Native AOT compatible. Bring your own FFmpeg 9 shared libraries.</Description>
    <PackageTags>ffmpeg;libav;interop;bindings;video;audio;codec;encoder;decoder;hardware;nvenc;amf;vaapi;videotoolbox;d3d12;vulkan;aot</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DotNet.ReproducibleBuilds" PrivateAssets="all" />
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <InternalsVisibleTo Include="FFmpeg.Interop.Tests" />
  </ItemGroup>
</Project>
